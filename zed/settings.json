{
  // ========================================
  // 基础配置 (Basic Configuration)
  // ========================================
  "agent_servers": {
    "opencode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
      "env": {},
    },
  },
  "base_keymap": "VSCode",
  "icon_theme": "Material Icon Theme",
  "theme": "Dayfox - opaque",

  // ========================================
  // 字体配置 (Font Configuration)
  // ========================================
  "buffer_font_family": "CaskaydiaMono Nerd Font",
  "buffer_font_size": 18.0,
  "ui_font_family": "CaskaydiaMono Nerd Font",
  "ui_font_size": 18,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 18,

  // ========================================
  // 终端配置 (Terminal Configuration)
  // ========================================
  "terminal": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 14,
  },

  // ========================================
  // 编辑器功能 (Editor Features)
  // ========================================
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "minimap": {
    "show": "auto",
  },

  // ========================================
  // 外部集成 (External Integration)
  // ========================================
  "agent": {
    "profiles": {
      "leetcode": {
        "name": "leetcode",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
      "notion": {
        "name": "notion",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "find_path": true,
          "grep": true,
          "move_path": true,
          "list_directory": true,
          "now": true,
          "open": true,
          "read_file": true,
          "terminal": true,
          "thinking": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-sequentialthinking-tools": {
            "tools": {
              "sequentialthinking_tools": true,
            },
          },
          "notionMCP": {
            "tools": {
              "notion-update-page": true,
              "notion-search": true,
              "notion-update-database": true,
              "notion-move-pages": true,
              "notion-get-users": true,
              "notion-get-user": true,
              "notion-get-teams": true,
              "notion-get-self": true,
              "notion-get-comments": true,
              "notion-duplicate-page": true,
              "notion-fetch": true,
              "notion-create-pages": true,
              "notion-create-database": true,
              "notion-create-comment": true,
            },
          },
        },
      },
    },
    "inline_assistant_model": {
      "provider": "薄荷",
      "model": "gemini-flash-latest",
    },
    "always_allow_tool_actions": true,
    "default_profile": "ask",
    "default_model": {
      "provider": "Elysia",
      "model": "glm-4.7",
    },
    "model_parameters": [],
  },
  "features": {
    "edit_prediction_provider": "zed",
  },
  "language_models": {
